# Copy this file to .env and fill in the values.

# --- Database ---
# With docker compose, only set POSTGRES_PASSWORD (DATABASE_URL is built for you).
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Without docker compose (Railway, Render, your own PostgreSQL), set the full URL instead:
# DATABASE_URL=postgres://user:password@host:5432/giftbox
# Set to true if your database host requires SSL (most cloud databases do):
# DATABASE_SSL=true

# --- Security ---
# A long random string (at least 32 characters). Generate one with:  openssl rand -hex 32
SESSION_SECRET=
NODE_ENV=production
# Cookies are sent over HTTPS only. Keep true on a real domain; set false only to test over plain http.
SECURE_COOKIES=true

# --- Main admin (first start only) ---
# Either set these two, and the main admin is created when the server first starts...
OWNER_EMAIL=
OWNER_PASSWORD=
# ...or leave them empty and create the main admin at https://your-domain/#admin
# using this setup code (if empty, a random code is printed in the server log).
SETUP_CODE=

# --- Order emails ---
# On Railway use Resend (Railway blocks SMTP). Put the real key only in your host's settings, never in GitHub.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=giftbox377 <orders@gbox377.com>
# The main admin and every active assistant with access to orders get each new order automatically.
# The customer gets an invoice when they type an email at checkout.
# Extra addresses for the order email (optional, comma-separated):
NOTIFY_EMAIL=gbox41409@gmail.com
# Your store's address, used for the "open admin" button in the email:
SITE_URL=https://gbox377.com
# Outgoing mail server. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER = your Gmail address, SMTP_PASS = a Google "App password" (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=giftbox377 <gbox41409@gmail.com>

# --- Domain (for the optional HTTPS setup with Caddy) ---
# DOMAIN=gbox377.com

# --- Other ---
APP_PORT=3000
MAX_UPLOAD_MB=25
